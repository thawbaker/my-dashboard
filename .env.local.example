# Required
JWT_SECRET=          # openssl rand -base64 32

# First-run admin, created by `npm run db:seed` (only if no admin exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
DATABASE_PATH=       # default ./data/dashboard.db
USER_DATA_DIR=       # per-user SQLite DBs (user-data/<username>.db); default ./user-data
ALLOWED_ORIGINS=     # optional comma list; empty = same-origin only (no CORS headers)
